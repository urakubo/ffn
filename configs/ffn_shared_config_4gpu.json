      },
      "v3": {
        "em_glob": "../ground_truth/em_soma_nucleus3/*",
        "seg_glob": "../ground_truth/soma_nucleus3/*",
        "partition_volume": "preprocessed_ground_truth2/af_v3.h5:af",
        "coordinate_output": "preprocessed_ground_truth2/tf_record_file_v3"
      }
    }
